# ----------------------------------------------------------------------------
# Firebase 設定（Spark / 無料プランでOK）
# ----------------------------------------------------------------------------
# これらを設定すると「クラウド同期モード」で起動し、複数デバイスで自動同期する。
# 未設定（空のまま）なら自動的に「ローカルモード」(localStorage) で動く。
#
# 値は Firebase Console > プロジェクト設定 > 「マイアプリ」(Web) から取得:
#   https://console.firebase.google.com/
#
# このファイルを `.env` にコピーして値を埋める:
#   cp .env.example .env
# ----------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ----------------------------------------------------------------------------
# 固定の共有リンク（任意）
# ----------------------------------------------------------------------------
# 設定すると、ドメイン直打み ( / ) で常にこの固定スペースに入る。
# 「毎回作成せず、いつも同じURLを使いたい」場合に便利。
# 値は好きな文字列でOK（例: futari-kitchen）。半角英数とハイフン推奨。
#   → https://あなたのドメイン/  も  https://あなたのドメイン/space/futari-kitchen  も同じ場所
VITE_DEFAULT_SPACE_ID=
